# Wyoming TTS Server Configuration
# TTS_HOST=127.0.0.1
# TTS_PORT=10200

# Wyoming STT Server Configuration
# STT_HOST=127.0.0.1
# STT_PORT=10300

# Gateway Server Configuration
HOST=0.0.0.0
PORT=8555
# Routes are served under PREFIX, /v1 and the root, so any of these works as an
# OpenAI-compatible base URL: http://host:8555  http://host:8555/  http://host:8555/v1
PREFIX=/v1

# Application Settings
# DEBUG=false
# LOG_LEVEL=INFO

# Map voice names the Wyoming TTS server does not have (OpenAI sends "alloy") onto
# one it does installed. Set false to forward voice names verbatim.
# VOICE_FALLBACK=true

# Decode audio miniaudio cannot open (m4a/AAC, webm/Opus) with ffmpeg from PATH.
# FFMPEG_FALLBACK=true
